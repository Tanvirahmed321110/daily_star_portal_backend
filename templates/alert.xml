<odoo>
    <!--===============  For Success Template  ===============-->
    <template id="success-template">
        <t t-call="purchase_requisition_tds.custom_layout">
            <main class="main">
                <div class="design active" id="d1" style="position:relative;">

                    <div id="d1-success" class="d1-card">
                        <div class="d1-ring success">
                            <svg width="30" height="32" viewBox="0 0 24 24" fill="none"
                                 xmlns="http://www.w3.org/2000/svg">
                                <path d="M20 6L9 17L4 12"
                                      stroke="#22c55e"
                                      stroke-width="2.5"
                                      stroke-linecap="round"
                                      stroke-linejoin="round"/>
                            </svg>
                        </div>
                        <div class="d1-title">Requisition Submitted!</div>
                        <div class="d1-sub">Your request has been forwarded to the Operations department and is
                            currently
                            under review.
                        </div>
                        <div class="d1-meta">
                            <div class="d1-row">
                                <span class="d1-k">SL NUMBER</span>
                                <span class="d1-v" t-esc="requisition.name">LPR/2026/0040</span>
                            </div>
                            <div class="d1-row">
                                <span class="d1-k">SUBMITTED BY</span>
                                <span class="d1-v" t-esc="name"></span>
                            </div>
                            <div class="d1-row">
                                <span class="d1-k">DEPARTMENT</span>
                                <span class="d1-v" t-esc="department"></span>
                            </div>
                            <div class="d1-row">
                                <span class="d1-k">DATE</span>
                                <span class="d1-v" t-esc="requisition.request_date"></span>
                            </div>
                            <div class="d1-row">
                                <span class="d1-k">STATUS</span>
                                <span class="d1-v" style="color:var(--success)">⬤ Pending Review</span>
                            </div>
                        </div>
                        <a style="width:100%;justify-content:center;padding:14px;" href="/dashboard"
                           class="new-req-btn btn btn-primary dashboard-btn">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor"
                                 viewBox="0 0 16 16" style="margin-right:6px;">
                                <path d="M0 0h7v7H0V0zm9 0h7v7H9V0zM0 9h7v7H0V9zm9 0h7v7H9V9z"/>
                            </svg>
                            Back to Dashboard
                        </a>
                    </div>

                    <div id="d1-error" class="d1-card" style="display:none">
                        <div class="d1-ring error">✕</div>
                        <div class="d1-title">Submission Failed</div>
                        <div class="d1-sub">Your form has validation errors. Please fix them and resubmit.</div>
                        <div class="d1-err-box">
                            <div class="d1-err-item">Row #01 — Product not selected</div>
                            <div class="d1-err-item">Row #02 — Product not selected</div>
                        </div>
                        <a href="/dashboard" class="d1-btn error">← Go Back &amp; Fix</a>
                    </div>
                </div>
            </main>
        </t>
    </template>


    <!--===============  For Error Template  ===============-->
    <template id="error-template">
        <t t-call="purchase_requisition_tds.custom_layout">

        </t>
    </template>
</odoo>