<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_requisition_dashboard" name=" Portal Dashboard">
        <t t-call="purchase_requisition_tds.custom_layout">
            <!--  css link   -->
            <link rel="stylesheet" type="text/css"
                  href="/purchase_requisition_tds/static/src/css/pages.css?v=1"/>

            <!--====================||  MAIN CONTENT  ||=================-->
            <main class="main">
                <div class="container">
                    <div class="page-header">
                        <!-- page header here -->
                        <h1 class="page-title">
                            <span>Requisition Dashboard</span>
                        </h1>
                        <div>
                            <a href="/dashboard/requisition" class="new-req-btn btn btn-primary">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="12" y1="5" x2="12" y2="19"></line>
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                </svg>
                                New Requisition
                            </a>
                        </div>
                    </div>

                    <div class="summary-grid" id="summaryGrid">

                        <!-- Total -->
                        <div class="s-card total">
                            <div class="s-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white"
                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                </svg>
                            </div>
                            <div class="s-label">Total</div>
                            <div class="s-value" t-esc="'%02d' % len(requisitions) if requisitions else '00'">12</div>
                        </div>

                        <!-- Pending -->
                        <div class="s-card pending">
                            <div class="s-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white"
                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <polyline points="12 6 12 12 16 14"></polyline>
                                </svg>
                            </div>
                            <div class="s-label">Forwarded</div>
                            <div class="s-value" t-esc="'%02d' % forwarded_count if forwarded_count else '00'"></div>
                        </div>

                        <!-- Approved -->
                        <div class="s-card approved">
                            <div class="s-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white"
                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                            </div>
                            <div class="s-label">Approved</div>
                            <div class="s-value" t-esc="'%02d' % approved_count if approved_count else '00'"></div>
                        </div>

                        <!-- Cancelled -->
                        <div class="s-card rejected">
                            <div class="s-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white"
                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="15" y1="9" x2="9" y2="15"></line>
                                    <line x1="9" y1="9" x2="15" y2="15"></line>
                                </svg>
                            </div>
                            <div class="s-label">Cancelled</div>
                            <div class="s-value" t-esc="'%02d' % cancelled_count if cancelled_count else '00'"></div>
                        </div>
                    </div>

                    <!--==================||  User Information Here  ||====================-->
                    <div class="user-card">
                        <div class="user-avatar">
                            <img t-att-src="image_data_uri(employee_image)"
                                alt="user"/>
                        </div>
                        <div class="user-details">
                            <div class="user-field"><label>Full Name</label>
                                <div class="value" t-esc="name"></div>
                            </div>
                            <div class="user-field"><label>Designation</label>
                                <div class="value" t-esc="designation"></div>
                            </div>
                            <div class="user-field"><label>Department</label>
                                <div class="value" t-esc="department"></div>
                            </div>
                            <div class="user-field"><label>HR ID</label>
                                <div class="value id" t-esc="hr_id"></div>
                            </div>
                        </div>
                    </div>

                    <!--==================||   Filter Header Here  ||====================-->
                    <t t-if=" requisitions">
                        <div class="filter-bar">
                            <div style="position:relative; display:inline-block; width:300px;">
                                <svg style="position:absolute; right:12px; top:50%; transform:translateY(-50%); pointer-events:none;"
                                    width="16" height="16" viewBox="0 0 24 24" fill="none"
                                    stroke="#999" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="11" cy="11" r="8"/>
                                    <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                                </svg>
                                <input type="text" id="searchInput" placeholder="Search by SL number..." style="width:100%"/>
                            </div>
                            <div class="filter-right">
                                <select id="statusFilter">
                                    <option value="">All Statuses</option>
                                    <t t-foreach="requisitions" t-as="req">
                                        <option style="text-transform:capitalize" t-att-value="req.state">
                                            <t t-esc="req.state"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                        </div>
                    </t>

                    <!--==================||  Requisition History Table  Here  ||====================-->
                    <div class="table-card">
                        <table style="width:100%;border-collapse:collapse;">
                            <thead>
                                <tr class="table-header-row">
                                    <th class="sl-th">#</th>
                                    <th>SL Number</th>
                                    <th>Date</th>
                                    <th>Items</th>
                                    <th>Priority</th>
                                    <th>Status</th>
                                    <th style="text-align: center;">View</th>
                                </tr>
                            </thead>
                            <tbody id="tableBody">
                                <t t-if="requisitions and len(requisitions) > 0">
                                    <t t-foreach="requisitions" t-as="req">
                                        <tr class="table-row"
                                            t-attf-data-status="{{req.state}}"
                                            t-attf-data-name="{{req.name}}">
                                            <td class="sl-th">
                                                <span
                                                        style="font-size:12px;font-weight:600;color:var(--muted);">
                                                    <t t-esc="req_index + 1"/>.
                                                </span>
                                            </td>
                                            <td>
                                                <span class="sl-num" t-esc="req.name"></span>
                                            </td>
                                            <td>
                                                <span class="req-date" t-esc="req.request_date"></span>
                                            </td>
                                            <td>
                                                <span class="items" t-esc="requisition_count.get(req.id, 0)"></span>
                                            </td>
                                            <td>
                                                <span class="badge " style="text-transform:Capitalize">
                                                    <t t-if="req.priority == 'high'">
                                                        🔴
                                                        <t t-esc="req.priority"/>
                                                    </t>
                                                    <t t-elif="req.priority == 'medium'">
                                                        🟡
                                                        <t t-esc="req.priority"/>
                                                    </t>
                                                    <t t-else="">
                                                        🟢
                                                        <t t-esc="req.priority"/>
                                                    </t>
                                                </span>
                                            </td>
                                            <td>
                                                <span class="status-badge pending" style="text-transform:Capitalize">
                                                    <t t-esc="req.state"/>
                                                </span>
                                            </td>
                                            <td style="text-align:center;">
                                                <a t-attf-href="/dashboard/requisition_details/{{req.id}}"
                                                   class="view-btn">
                                                    View
                                                    <!-- Eye / View Icon -->
                                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                                                         stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
                                                         stroke-linejoin="round">

                                                        <!-- Eye Shape -->
                                                        <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/>

                                                        <!-- Eye Ball -->
                                                        <circle cx="12" cy="12" r="3"/>
                                                    </svg>
                                                </a>
                                            </td>
                                        </tr>
                                    </t>

                                    <tr id="emptyFilter" style="display:none;">
                                        <td colspan="7" style="padding:0;border:none;">
                                            <div class="empty-1">
                                                <div class="e1-icon-wrap">
                                                    <div class="e1-rings"></div>
                                                    <div class="e1-doc">
                                                        <div class="e1-lines">
                                                            <div class="e1-line"></div>
                                                            <div class="e1-line"></div>
                                                            <div class="e1-line"></div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <h3>No Results Found</h3>
                                                <p>No requisitions found for the selected filter.</p>
                                                <a href="/dashboard/requisition" class="btn-1">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                                        stroke="currentColor" stroke-width="2.5">
                                                        <line x1="12" y1="5" x2="12" y2="19"/>
                                                        <line x1="5" y1="12" x2="19" y2="12"/>
                                                    </svg>
                                                    New Requisition
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                </t>

                                <!-- When Item Not Found / Available -->
                                <t t-else="">
                                    <tr>
                                        <td colspan="7" style="padding:0;border:none;">
                                            <!-- DESIGN 4 -->
                                            <!-- DESIGN 1 -->
                                            <div class="empty-1">
                                                <div class="e1-icon-wrap">
                                                    <div class="e1-rings"></div>
                                                    <div class="e1-doc">
                                                        <div class="e1-lines">
                                                            <div class="e1-line"></div>
                                                            <div class="e1-line"></div>
                                                            <div class="e1-line"></div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <h3>No Requisitions Yet</h3>
                                                <p>You haven't submitted any purchase requisitions. Start by
                                                    creating your first one.
                                                </p>
                                                <a href="/dashboard/requisition" class="btn-1">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                                         stroke="currentColor" stroke-width="2.5">
                                                        <line x1="12" y1="5" x2="12" y2="19"/>
                                                        <line x1="5" y1="12" x2="19" y2="12"/>
                                                    </svg>
                                                    New Requisition
                                                </a>
                                            </div>

                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>

                </div>
            </main>

            <script src="../../../purchase_requisition_tds/static/src/js/dashboard.js?v=1"></script>
        </t>
    </template>
</odoo>
