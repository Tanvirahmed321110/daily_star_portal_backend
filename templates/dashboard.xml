                            </div>
                            <div class="user-field"><label>HR ID</label>
                                <div class="value id">HR-2024-0142</div>
                            </div>
                        </div>
                    </div> -->

                    <!--==================||   Filter Header Here  ||====================-->
                    <t t-if=" requisitions">
                        <div class="filter-bar">
                            <input type="text" id="searchInput" placeholder="Search by SL number..."/>
                            <div class="filter-right">
                                <select id="statusFilter">
                                    <option value="">All Statuses</option>
                                    <option value="Pending">Pending</option>
                                    <option value="Approved">Approved</option>
                                    <option value="Rejected">Rejected</option>
                                </select>
                            </div>
                        </div>
                    </t>

                    <!--==================||  Requisition History Table  Here  ||====================-->
                    <div class="table-card">
                        <table style="width:100%;border-collapse:collapse;">
                            <thead>
                                <tr class="table-header-row">
                                    <th class="sl-th">#</th>
                                    <th>SL Number</th>
                                    <th>Date</th>
                                    <th>Items</th>
                                    <th>Priority</th>
                                    <th>Status</th>
                                    <th style="text-align: center;">View</th>
                                </tr>
                            </thead>
                            <tbody id="tableBody">
                                <t t-if="requisitions and len(requisitions) > 0">
                                    <t t-foreach="requisitions" t-as="req">
                                        <tr class="table-row">
                                            <td class="sl-th">
                                                <span
                                                        style="font-size:12px;font-weight:600;color:var(--muted);">
                                                    <t t-esc="req_index + 1"/>.
                                                </span>
                                            </td>
                                            <td>
                                                <span class="sl-num" t-esc="req.name"></span>
                                            </td>
                                            <td>
                                                <span class="req-date" t-esc="req.request_date"></span>
                                            </td>
                                            <td>
                                                <span class="items" t-esc="requisition_count.get(req.id, 0)"> </span>
                                            </td>
                                            <td>
                                                <span class="badge high" t-esc="req.priority"
                                                      style="text-transform:Capitalize"></span>
                                            </td>
                                            <td>
                                                <span class="status-badge pending" style="text-transform:Capitalize">
                                                    <t t-esc="req.state"/>
                                                </span>
                                            </td>
                                            <td style="text-align:center;">
                                                <a t-attf-href="/dashboard/requisition_details/{{req.id}}" class="view-btn">
                                                    View
                                                    <!-- Eye / View Icon -->
                                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                                                         stroke="currentColor" stroke-width="2.2" stroke-linecap="round"
                                                         stroke-linejoin="round">

                                                        <!-- Eye Shape -->
                                                        <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/>

                                                        <!-- Eye Ball -->
                                                        <circle cx="12" cy="12" r="3"/>
                                                    </svg>
                                                </a>
                                            </td>
                                        </tr>
                                    </t>
                                </t>

                                <!-- When Item Not Found / Available -->
                                <t t-else="">
                                    <tr>
                                        <td colspan="7" style="padding:0;border:none;">
                                            <!-- DESIGN 4 -->
                                            <!-- DESIGN 1 -->
                                                <div class="empty-1">
                                                    <div class="e1-icon-wrap">
                                                        <div class="e1-rings"></div>
                                                        <div class="e1-doc">
                                                            <div class="e1-lines">
                                                                <div class="e1-line"></div>
                                                                <div class="e1-line"></div>
                                                                <div class="e1-line"></div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <h3>No Requisitions Yet</h3>
                                                    <p>You haven't submitted any purchase requisitions. Start by
                                                        creating your first one.
                                                    </p>
                                                    <a href="/dashboard/requisition" class="btn-1">
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                                             stroke="currentColor" stroke-width="2.5">
                                                            <line x1="12" y1="5" x2="12" y2="19"/>
                                                            <line x1="5" y1="12" x2="19" y2="12"/>
                                                        </svg>
                                                        New Requisition
                                                    </a>
                                                </div>

                                        </td>
                                    </tr>
                                </t>

                                <!--                                <tr class="table-row">-->
                                <!--                                    <td class="sl-th">-->
                                <!--                                        <span-->
                                <!--                                                style="font-family:'DM Mono',monospace;font-size:12px;color:var(&#45;&#45;muted);">-->
                                <!--                                            02-->
                                <!--                                        </span>-->
                                <!--                                    </td>-->
                                <!--                                    <td>-->
                                <!--                                        <span class="sl-num">REQ-2026-00831</span>-->
                                <!--                                    </td>-->
                                <!--                                    <td>-->
                                <!--                                        <span class="req-date">2026-05-15</span>-->
                                <!--                                    </td>-->
                                <!--                                    <td>-->
                                <!--                                        <span class="items">2</span>-->
                                <!--                                    </td>-->
                                <!--                                    <td>-->
                                <!--                                        <span class="badge medium">🟡 Medium</span>-->
                                <!--                                    </td>-->
                                <!--                                    <td>-->
                                <!--                                        <span class="status-badge approved">Approved</span>-->
                                <!--                                    </td>-->
                                <!--                                    <td style="text-align:center;">-->
                                <!--                                        <a href="view.html?sl=REQ-2026-00831" class="view-btn">-->
                                <!--                                            View-->
                                <!--                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"-->
                                <!--                                                 stroke="currentColor" stroke-width="2.2" stroke-linecap="round"-->
                                <!--                                                 stroke-linejoin="round">-->

                                <!--                                                &lt;!&ndash; Eye Shape &ndash;&gt;-->
                                <!--                                                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/>-->

                                <!--                                                &lt;!&ndash; Eye Ball &ndash;&gt;-->
                                <!--                                                <circle cx="12" cy="12" r="3"/>-->
                                <!--                                            </svg>-->
                                <!--                                        </a>-->
                                <!--                                    </td>-->
                                <!--                                </tr>-->
                            </tbody>
                        </table>
                    </div>

                </div>
            </main>
        </t>
    </template>
</odoo>
