<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_requisition_dashboard" name=" Portal Dashboard">
        <t t-call="purchase_requisition_tds.custom_layout">
            <!--  css link   -->
            <link rel="stylesheet" type="text/css"
                  href="/purchase_requisition_tds/static/src/css/pages.css"/>

            <!--====================||  MAIN CONTENT  ||=================-->
            <main class="main">
                <div class="container">
                    <div class="page-header">
                        <!-- page header here -->
                        <h1 class="page-title">
                            <span>Requisition Dashboard</span>
                        </h1>
                        <div>
                            <a href="/dashboard/requisition" class="new-req-btn btn btn-primary">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                     stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="12" y1="5" x2="12" y2="19"></line>
                                    <line x1="5" y1="12" x2="19" y2="12"></line>
                                </svg>
                                New Requisition
                            </a>
                        </div>
                    </div>

                    <div class="summary-grid" id="summaryGrid">

                        <!-- Total -->
                        <div class="s-card total">
                            <div class="s-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white"
                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                </svg>
                            </div>
                            <div class="s-label">Total</div>
                            <div class="s-value" t-esc="'%02d' % len(requisitions) if requisitions else '00'">12</div>
                        </div>

                        <!-- Pending -->
                        <div class="s-card pending">
                            <div class="s-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white"
                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <polyline points="12 6 12 12 16 14"></polyline>
                                </svg>
                            </div>
                            <div class="s-label">Forwarded</div>
                            <div class="s-value" t-esc="'%02d' % forwarded_count if forwarded_count else '00'"></div>
                        </div>

                        <!-- Approved -->
                        <div class="s-card approved">
                            <div class="s-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white"
                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                            </div>
                            <div class="s-label">Approved</div>
                            <div class="s-value" t-esc="'%02d' % approved_count if approved_count else '00'"></div>
                        </div>

                        <!-- Cancelled -->
                        <div class="s-card rejected">
                            <div class="s-icon">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white"
                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="15" y1="9" x2="9" y2="15"></line>
                                    <line x1="9" y1="9" x2="15" y2="15"></line>
                                </svg>
                            </div>
                            <div class="s-label">Cancelled</div>
                            <div class="s-value" t-esc="'%02d' % cancelled_count if cancelled_count else '00'"></div>
                        </div>
                    </div>

                    <!--==================||  User Information Here  ||====================-->
                    <!-- <div class="user-card">
                        <div class="user-avatar">
                            <img src="https://lh3.googleusercontent.com/a/ACg8ocLiFW0fYS0vL3mAnqt2sQMgamQjc5RYvbjADXkbHQHgW0VXriJi=s192-c-mo"
