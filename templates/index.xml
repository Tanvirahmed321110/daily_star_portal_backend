<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_requisition_form" name="Requisition Portal">
        <t t-call="purchase_requisition_tds.custom_layout">

            <!--====================||  MAIN CONTENT  ||=================-->
            <main class="main">
                <div class="container">
                    <div class="page-header">
                        <div>
                            <!-- page header here -->
                            <h1 class="page-title">
                                <span>Requisition Portal</span>
                            </h1>
                        </div>
                    </div>

                    <!--==================||  User Information Here  ||====================-->
                    <div class="user-card">
                        <div class="user-avatar">
                            <img t-att-src="employee_image" alt="user image"/>
                        </div>
                        <div class="user-details">
                            <div class="user-field">
                                <label>Full Name</label>
                                <div class="value" t-esc="name "></div>
                            </div>
                            <div class="user-field">
                                <label>Designation</label>
                                <div class="value" t-esc="designation"></div>
                            </div>
                            <div class="user-field">
                                <label>Department</label>
                                <div class="value" t-esc="department"></div>
                            </div>
                            <div class="user-field">
                                <label>HR ID</label>
                                <div class="value id" t-esc="hr_id"></div>
                            </div>
                        </div>
                    </div>

                    <!--==================||  Main Form Here  ||====================-->
                    <form action="/requisition/submit"
                        method="post"
                        id="requisitionForm"
                        class="form-card">

                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                        <!-- ================= TOP SECTION ================= -->
                        <div class="form-top">

                            <div class="field-group">
                                <label>SL Number</label>
                                <div class="sl-badge" t-esc="requisition.name"></div>
                            </div>

                            <div class="field-group">
                                <label>Date</label>
                                <input type="date" name="request_date" id="reqDate"
                                    t-att-value="today" readonly="readonly"/>
                            </div>

                            <div class="field-group">
                                <label>Priority</label>

                                <div class="priority-group">
                                    <div class="priority-btn" data-value="high">🟢 High</div>
                                    <div class="priority-btn" data-value="medium">🟡 Medium</div>
                                    <div class="priority-btn active" data-value="low">🔴 Low</div>
                                </div>

                                <input type="hidden" name="priority" id="priority-input" value="low"/>
                            </div>

                        </div>

                        <!-- ================= PRODUCT SECTION ================= -->
                        <div class="section-title">Products Lines</div>

                        <table class="product-table">

                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Product</th>
                                    <th>Product Name</th>
                                    <th>Qty</th>
                                    <th>Required On</th>
                                    <th>Remarks</th>
                                </tr>
                            </thead>

                            <tbody id="js-product-table-body">

                                <!-- ================= SINGLE ROW ================= -->
                                <tr>

                                    <td class="sl-no"  style="color:var(--muted);font-family:'DM Mono',monospace;font-size:12px;">01</td>

                                    <!-- PRODUCT SELECT -->
                                    <td>
                                        <select name="product_id"
                                                class="product-category" onchange="onCategoryChange(this)">
                                            <option value="">Select product...</option>
                                            <t t-foreach="products" t-as="product">
                                                <option t-att-value="product.id"
                                                        t-esc="product.name"/>
                                            </t>
                                        </select>
                                    </td>

                                    <!-- PRODUCT NAME -->
                                    <td>
                                        <input type="text"
                                            name="description"
                                            class="product-name"
                                            placeholder="Product Name"/>
                                    </td>

                                    <!-- QTY -->
                                    <td>
                                        <input type="number"
                                            name="required_qty"
                                            class="quantity"
                                            value="1"
                                            min="1"/>
                                    </td>

                                    <!-- DATE -->
                                    <td>
                                        <input type="date"
                                            name="required_on"
                                            required="required"
                                            class="required-date"/>
                                    </td>

                                    <!-- REMARKS -->
                                    <td>
                                        <input type="text"
                                            name="remarks"
                                            class="remarks"
                                            placeholder="Additional notes..."/>
                                    </td>

                                </tr>

                            </tbody>
                        </table>

                        <!-- ================= ADD ROW BUTTON ================= -->
                        <button type="button" class="add-row-btn">
                            + Add Product Row
                        </button>

                        <!-- ================= SUBMIT ================= -->
                        <div class="form-actions">

                            <button type="submit" class="btn btn-primary" id="submitBtn">
                                Submit Requisition
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="margin-left: 8px;">
                                    <path d="M22 2L11 13M22 2L15 22L11 13M22 2L2 9L11 13" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                                </svg>
                            </button>

                        </div>

                    </form>
                </div>
            </main>
        </t>
    </template>
</odoo>
